    <startEvent id="s" name="Request arrives"/>
    <task id="t1" name="Receive request"/>
    <task id="t2" name="Check identity"/>
    <task id="t3" name="Classify request"/>
    <task id="t4" name="Check budget"/>
    <task id="t5" name="Get approval"/>
    <task id="t6" name="Order item"/>
    <task id="t7" name="Receive item"/>
    <task id="t8" name="Hand over item"/>
    <task id="t9" name="Close request"/>
    <endEvent id="e" name="Request closed"/>
    <sequenceFlow id="f0" sourceRef="s" targetRef="t1"/>
    <sequenceFlow id="f1" sourceRef="t1" targetRef="t2"/>
    <sequenceFlow id="f2" sourceRef="t2" targetRef="t3"/>
    <sequenceFlow id="f3" sourceRef="t3" targetRef="t4"/>
