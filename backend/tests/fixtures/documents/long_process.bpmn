    <sequenceFlow id="f5" sourceRef="t5" targetRef="t6"/>
    <sequenceFlow id="f6" sourceRef="t6" targetRef="t7"/>
    <sequenceFlow id="f7" sourceRef="t7" targetRef="t8"/>
    <sequenceFlow id="f8" sourceRef="t8" targetRef="t9"/>
    <sequenceFlow id="f9" sourceRef="t9" targetRef="e"/>
  </process>
