# Discovery Agent backend settings (spec 10 §3.5, spec 11 §4). Copy to backend/.env for local runs.
DEPLOYMENT_STAGE=local
COMPANY_CONFIG_DIR=../config/nig
# Store (spec 15): memory for tests and local runs; cosmos in Azure (the demo stage requires it).
STORE=memory
# Cosmos DB: Entra auth only (your `az login` locally, managed identity in Azure via AZURE_CLIENT_ID).
# No key: the account has local auth disabled. Bicep creates the database and container.
# COSMOS_ENDPOINT=https://<account>.documents.azure.com:443/
# COSMOS_DATABASE=discovery
# COSMOS_CONTAINER=sessions
# Unfinished sessions and open or dismissed ideas expire after this many days (1-365).
SESSION_RETENTION_DAYS=90

# Azure OpenAI: identity only (your `az login` locally, managed identity in Azure). No keys.
AZURE_OPENAI_ENDPOINT=https://northstar-discovery-ai.cognitiveservices.azure.com/
AZURE_OPENAI_DEPLOYMENT=app-chat
AZURE_OPENAI_EVAL_DEPLOYMENT=eval-expert
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Workspace access (development values; the demo stage refuses them)
WORKSPACE_CODE_SPECIALIST=dev-specialist
WORKSPACE_CODE_ENGINEER=dev-engineer
WORKSPACE_TOKEN_SECRET=dev-only-secret-change-me
# Limits for the open link (spec 16): slowapi syntax; the daily model budget in tokens (0 = unlimited).
RATE_LIMIT_PER_VISITOR=30/minute
RATE_LIMIT_PER_IP=120/minute
DAILY_TOKEN_BUDGET=2000000

LOG_LEVEL=INFO
# APPLICATIONINSIGHTS_CONNECTION_STRING=
